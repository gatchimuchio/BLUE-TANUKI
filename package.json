{
  "name": "blue-tanuki-workspace",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "description": "BLUE-TANUKI ワークスペース。判断・権限は HDS-BRAIN にあり、packages/ と apps/ はその下流実装である。",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "node scripts/clean.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node node_modules/vitest/vitest.mjs run && node scripts/assert_test_minimums.mjs",
    "docs:check": "node scripts/check_docs.mjs && tsx scripts/japanese_base_gate.ts && tsx scripts/licensing_gate.ts",
    "validate:licensing": "tsx scripts/licensing_gate.ts",
    "validate:japanese-base": "tsx scripts/japanese_base_gate.ts",
    "validate:repo-health": "tsx scripts/repo_health_gate.ts",
    "validate:release-hardening": "tsx scripts/release_hardening_gate.ts",
    "validate:channels": "tsx scripts/channel_promotion_gate.ts",
    "validate:ga": "tsx scripts/ga_promotion_gate.ts",
    "validate:product": "tsx scripts/validate_product.ts",
    "plugin:review": "tsx scripts/plugin_review_gate.ts",
    "gateway": "pnpm --filter @blue-tanuki/gateway run start",
    "gateway:dev": "pnpm --filter @blue-tanuki/gateway run dev",
    "gateway:serve": "pnpm --filter @blue-tanuki/gateway run serve",
    "gateway:serve:dev": "pnpm --filter @blue-tanuki/gateway run serve:dev",
    "doctor": "pnpm --filter @blue-tanuki/gateway run doctor",
    "doctor:dev": "pnpm --filter @blue-tanuki/gateway run doctor:dev",
    "installer:run": "tsx install/installer/src/index.ts",
    "installer:verify": "tsx install/installer/src/verify.ts",
    "package:windows": "tsx scripts/package_windows.ts",
    "package:windows:verify": "tsx scripts/verify_windows_package.ts",
    "package:linux": "tsx scripts/package_unix.ts --platform=linux",
    "package:linux:verify": "tsx scripts/verify_unix_package.ts --platform=linux",
    "package:macos": "tsx scripts/package_unix.ts --platform=macos --arch=x64 && tsx scripts/package_unix.ts --platform=macos --arch=arm64",
    "package:macos:verify": "tsx scripts/verify_unix_package.ts --platform=macos --arch=x64 && tsx scripts/verify_unix_package.ts --platform=macos --arch=arm64",
    "package:unix": "tsx scripts/package_unix.ts --all",
    "package:unix:verify": "tsx scripts/verify_unix_package.ts --all",
    "package:installers": "tsx scripts/package_product_installers.ts",
    "package:installers:verify": "tsx scripts/verify_product_installers.ts",
    "installer:windows": "pnpm package:windows",
    "installer:windows:verify": "pnpm package:windows:verify",
    "installer:linux": "pnpm package:linux",
    "installer:linux:verify": "pnpm package:linux:verify",
    "installer:macos": "pnpm package:macos",
    "installer:macos:verify": "pnpm package:macos:verify",
    "installer:product": "pnpm package:installers",
    "installer:product:verify": "pnpm package:installers:verify",
    "setup": "pnpm --filter @blue-tanuki/gateway run setup",
    "setup:dist": "pnpm --filter @blue-tanuki/gateway run setup:dist",
    "hds:standalone": "tsx examples/hds-brain-standalone.ts",
    "smoke:serve": "tsx scripts/smoke_serve.ts",
    "smoke:resume": "tsx scripts/smoke_resume.ts",
    "smoke:windows-installed": "tsx scripts/smoke_windows_installed.ts",
    "smoke:linux-installed": "tsx scripts/smoke_unix_installed.ts --platform=linux",
    "smoke:macos-installed": "tsx scripts/smoke_unix_installed.ts --platform=macos",
    "smoke:live": "tsx apps/gateway/src/smoke_live.ts",
    "validate:packaging": "tsx scripts/validate_packaging.ts",
    "release:bundle": "tsx scripts/create_release_bundle.ts",
    "release:verify": "tsx scripts/verify_release_bundle.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
