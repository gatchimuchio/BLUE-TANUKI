{
  "name": "@blue-tanuki/channel-teams",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Microsoft Teams preview channel with authenticated Agents SDK ingress and Microsoft Graph message send",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@blue-tanuki/channel-base": "workspace:*",
    "@blue-tanuki/protocol": "workspace:*",
    "@microsoft/agents-hosting": "1.9.1",
    "@microsoft/agents-hosting-express": "1.9.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
